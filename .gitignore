# ==========================================
# Vionex Backend - Git Ignore Rules
# Strictly prevents secret leakage and build bloat
# ==========================================

# Environment & Secret files
.env
.env.*
.env*.local
!.env.example
*.env
*.local

# Dependencies
node_modules/

# Production build outputs & cache
dist/
dist-ssr/
build/
.cache/

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
