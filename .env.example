# ==========================================
# VIONEX BACKEND - ENVIRONMENT CONFIG TEMPLATE
# ==========================================
# Copy to .env.development or .env.production as needed.

# Environment: 'development' or 'production'
NODE_ENV=development
PORT=8080

# Database:
# Development: mongodb://127.0.0.1:27017/vionex
# Production:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URL=mongodb://127.0.0.1:27017/vionex

# Allowed Client Origin (CORS):
# Development: http://localhost:5173
# Production:  https://vionex.netlify.app
CLIENT_ORIGIN=http://localhost:5173

# Optional: TURN / STUN server
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
